# Copy to .env and fill in. .env is git-ignored — never commit real values.
# On Vercel these go in Project Settings -> Environment Variables instead,
# where they stay server-side and are not exposed to the browser.

# --- Required in production -------------------------------------------------

# Long random string. Sessions are signed with it, so anyone who knows it can
# forge a staff login. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JATTA_SECRET_KEY=

# Marks this as a real deployment. The app refuses to start in production with
# the development secret key, and warns about SQLite and local file storage.
JATTA_ENV=production

# Supabase Postgres. Use the *transaction* pooler (port 6543) on Vercel: each
# request is a short-lived function and Supavisor owns the real connections.
# Copy it from Supabase -> Project Settings -> Database -> Connection string.
# Shape (do not commit the password):
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
JATTA_DATABASE_URL=

# --- Image storage ----------------------------------------------------------

# "supabase" or "local". Leave unset and it picks supabase when SUPABASE_URL is
# present, otherwise local disk. A serverless host must use supabase: its
# filesystem is read-only and discarded between invocations.
JATTA_STORAGE=supabase

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co

# SERVICE ROLE key, not the anon key. It bypasses row-level security, so it is
# server-only: never put it in a NEXT_PUBLIC_/VITE_ style variable or in client
# JavaScript.
SUPABASE_SERVICE_ROLE_KEY=

# Public bucket the pictures go in.
SUPABASE_STORAGE_BUCKET=media

# --- Optional ---------------------------------------------------------------

# The address search engines are given in canonical links and the sitemap.
# JATTA_PUBLIC_SITE_URL=https://gogo-taxi.com

# Postgres SSL. Supabase accepts connections without this set; use "require" if
# you want to insist on TLS.
# JATTA_DB_SSLMODE=require

# Connection pool sizing. Ignored on the transaction pooler, which uses no
# client-side pool at all.
# JATTA_DB_POOL_SIZE=5
# JATTA_DB_MAX_OVERFLOW=5
# JATTA_DB_POOL_RECYCLE=1800
# JATTA_DB_CONNECT_TIMEOUT=10

# Force the pool off even on port 5432 (set to "none").
# JATTA_DB_POOL=

# How long browsers and the CDN may cache an uploaded picture. Filenames are
# unique per upload, so a replaced image is a new URL.
# JATTA_UPLOAD_CACHE_SECONDS=31536000

# First staff account. On a production start with no staff account yet, the
# app creates one from these (password at least 12 characters). Set them in the
# host's secret settings, deploy once, then delete JATTA_ADMIN_PASSWORD.
# The seed script reads them too.
# JATTA_ADMIN_USER=admin
# JATTA_ADMIN_PASSWORD=

# Production creates the schema from supabase/bootstrap.sql when the database
# has no tables at all, and never alters a database that has tables. Set to 0
# to turn that off.
# JATTA_AUTO_BOOTSTRAP=1

# --- Driver sign-in by text message ---------------------------------------

# Unset in production until a real provider is set up and tested on Gambian
# phones: phone sign-in then says it is unavailable. "fake" is for a local
# computer only (codes are written to instance/dev_sms_outbox.jsonl and shown
# to signed-in staff under Admin -> Test text messages); production refuses it.
# JATTA_SMS_BACKEND=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Either a Messaging Service with an alphanumeric sender in its pool...
# TWILIO_MESSAGING_SERVICE_SID=
# ...or an alphanumeric sender ID directly (max 11 characters).
# TWILIO_FROM=
# The site's own domain, so phones can offer to fill in the code (WebOTP).
# JATTA_SMS_WEBOTP_DOMAIN=example.gm

# How many proxies add X-Forwarded-For in front of the app (Render: 1). Sign-in
# rate limits count per visitor IP; 0 trusts no header.
# JATTA_TRUSTED_PROXIES=1

# Limits (defaults shown).
# JATTA_SMS_CODE_TTL_SECONDS=600
# JATTA_SMS_CODE_MAX_ATTEMPTS=5
# JATTA_SMS_RESEND_SECONDS=60
# JATTA_SMS_MAX_PER_NUMBER_HOUR=5
# JATTA_SMS_MAX_PER_NUMBER_DAY=10
# JATTA_SMS_MAX_PER_IP_HOUR=10
# JATTA_SMS_MAX_PER_DAY=300
# JATTA_SMS_WRONG_CODES_PER_IP_HOUR=30
# JATTA_DRIVER_SESSION_DAYS=14
# JATTA_DRIVER_ACCEPT_SECONDS=120
